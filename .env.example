# Sao chép file này thành .env rồi điền GROQ_API_KEY (lấy miễn phí tại https://console.groq.com/)
GROQ_API_KEY=gsk_...

# ===== LLM (tuỳ chọn — có default trong src/config.py) =====
# LLM_MODEL=llama-3.3-70b-versatile
# EXTRACT_MODEL=llama-3.1-8b-instant      # model nhẹ cho bước trích xuất thực thể
# LLM_TEMPERATURE=0.1
# LLM_REQUESTS_PER_MINUTE=30

# ===== Embedding =====
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=cpu                    # "cuda" nếu có GPU

# ===== Chunking / Retrieval =====
# CHUNK_SIZE=512
# CHUNK_OVERLAP=50                        # chốt nhóm = 50
# TOP_K_RETRIEVE=50
# TOP_K_FINAL=5

# ===== GraphRAG backend =====
# Mặc định "memory" (không cần Neo4j). Đặt "neo4j" nếu đã dựng Neo4j.
# GRAPH_BACKEND=memory
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=                         # KHÔNG commit password lên git
# NEO4J_DATABASE=neo4j
