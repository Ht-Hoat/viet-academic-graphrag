# Sao chép file này thành .env rồi điền GROQ_API_KEY (lấy miễn phí tại https://console.groq.com/)
GROQ_API_KEY=gsk_...

# Tùy chọn — đã có giá trị mặc định trong src/config.py, chỉ đặt khi muốn đổi:
# LLM_MODEL=llama-3.3-70b-versatile
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=cpu          # đổi "cuda" nếu có GPU
# CHUNK_SIZE=512
# CHUNK_OVERLAP=80
# TOP_K_FINAL=5
# TOP_K_RETRIEVE=50
GROQ_API_KEY=your_groq_key_here
LLM_MODEL=llama-3.3-70b-versatile
# EXTRACT_MODEL=llama-3.1-8b-instant
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag123
